# Développement local. Utiliser des valeurs robustes et secrètes en production.
DJANGO_SECRET_KEY=changez-cette-valeur-en-production
DJANGO_DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
DATABASE_URL=postgresql://amelone:amelone@127.0.0.1:5432/amelone
SITE_URL=http://localhost:8000

# L'envoi reste désactivé tant qu'un SMTP réel n'est pas configuré.
EMAIL_ENABLED=0
# django : SMTP existant ; brevo : e-mails via API HTTPS (utile sur Render Free).
EMAIL_PROVIDER=django
# Vide : sélection automatique selon EMAIL_PROVIDER ; les confirmations et
# réinitialisations de mot de passe passent aussi par Brevo si sélectionné.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=AMELONE <noreply@example.org>

# Notifications d'événements : désactivées tant que les canaux ne sont pas prêts.
EVENT_NOTIFICATIONS_ENABLED=0
# Clé privée, à configurer uniquement dans les variables du serveur.
BREVO_API_KEY=
SMS_ENABLED=0
SMS_PROVIDER=
# Avec SMS_PROVIDER=brevo : 3 à 11 lettres/chiffres, par exemple AMELONE.
SMS_SENDER=

SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
SECURE_SSL_REDIRECT=0
# Production uniquement : 31536000 après validation complète du HTTPS.
SECURE_HSTS_SECONDS=0

